// Prisma Schema — Laporan SPK H-1
// Agung Toyota UjungBatu

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN       // Kelola sistem & isi keterangan
  SPV         // Supervisor — approve/reject SPK
  SALES       // Input plan SPK H-1
  SUPERADMIN  // Superadmin — kontrol penuh sistem & server
}

enum SpkStatus {
  PENDING         // Rencana / Menunggu Hari H
  BERHASIL        // SPK Berhasil (Closing)
  BELUM_BERHASIL  // Belum Berhasil SPK
}

// ─── MODELS ───────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(uuid())
  name      String
  nip       String?   @unique
  username  String?   @unique
  email     String?   @unique
  password  String
  role      Role      @default(SALES)
  title     String?
  phone     String?
  isActive  Boolean   @default(true) @map("is_active")
  planSpks  PlanSPK[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model PlanSPK {
  id                String    @id @default(uuid())
  salesId           String    @map("sales_id")
  sales             User      @relation(fields: [salesId], references: [id], onDelete: Cascade)

  customerName      String    @map("customer_name")
  unitName          String    @map("unit_name")

  planDate          DateTime  @map("plan_date")

  spkStatus         SpkStatus @default(PENDING) @map("spk_status")
  keterangan        String?   @db.Text
  keteranganSpv     String?   @map("keterangan_spv") @db.Text
  keteranganAdmin   String?   @map("keterangan_admin") @db.Text

  isDuplicate       Boolean   @default(false) @map("is_duplicate")
  isRepeatFailed    Boolean   @default(false) @map("is_repeat_failed")
  isUnplanned       Boolean   @default(false) @map("is_unplanned")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([salesId])
  @@index([planDate])
  @@index([customerName, salesId])
  @@index([isDuplicate])
  @@index([spkStatus])
  // Functional index PostgreSQL Neon (dibuat via scripts/add-lower-index.ts):
  // CREATE INDEX IF NOT EXISTS idx_plan_spk_customer_name_lower ON plan_spk (LOWER(customer_name));
  @@map("plan_spk")
}

// ─── WHATSAPP BROADCAST ENGINE (MODUL 3) ───────────────────────────────────

model WhatsAppSetting {
  id                    String   @id @default("cabang_220")
  targetGroupId         String?  @map("target_group_id")
  targetGroupName       String?  @map("target_group_name")
  isMorningBlastActive  Boolean  @default(true) @map("is_morning_blast_active")
  morningBlastTime      String   @default("08:00") @map("morning_blast_time")
  isEveningBlastActive  Boolean  @default(true) @map("is_evening_blast_active")
  eveningBlastTime      String   @default("17:15") @map("evening_blast_time")
  sendReportToBm        Boolean  @default(false) @map("send_report_to_bm")
  sendReportToAdh       Boolean  @default(false) @map("send_report_to_adh")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_settings")
}

model WhatsAppMessage {
  id           String    @id @default(cuid())
  messageType  String    @map("message_type")
  targetJid    String    @map("target_jid")
  targetName   String?   @map("target_name")
  content      String    @db.Text
  hasDocument  Boolean   @default(false) @map("has_document")
  documentName String?   @map("document_name")
  status       String    @default("PENDING")
  errorMessage String?   @map("error_message")
  sentAt       DateTime? @map("sent_at")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("whatsapp_messages")
}
