// Prisma Schema — Laporan SPK H-1
// Agung Toyota UjungBatu

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN  // Kelola sistem & isi keterangan
  SPV    // Supervisor — approve/reject SPK
  SALES  // Input plan SPK H-1
}

enum SpkStatus {
  PENDING         // Rencana / Menunggu Hari H
  BERHASIL        // SPK Berhasil (Closing)
  BELUM_BERHASIL  // Belum Berhasil SPK
}

// ─── MODELS ───────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(uuid())
  name      String
  nip       String?   @unique
  username  String?   @unique
  email     String?   @unique
  password  String
  role      Role      @default(SALES)
  title     String?
  phone     String?
  isActive  Boolean   @default(true) @map("is_active")
  planSpks  PlanSPK[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model PlanSPK {
  id                String    @id @default(uuid())
  salesId           String    @map("sales_id")
  sales             User      @relation(fields: [salesId], references: [id], onDelete: Cascade)

  customerName      String    @map("customer_name")
  unitName          String    @map("unit_name")

  planDate          DateTime  @map("plan_date")

  spkStatus         SpkStatus @default(PENDING) @map("spk_status")
  keterangan        String?   @db.Text

  isDuplicate       Boolean   @default(false) @map("is_duplicate")
  isRepeatFailed    Boolean   @default(false) @map("is_repeat_failed")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([salesId])
  @@index([planDate])
  @@index([customerName, salesId])
  @@index([isDuplicate])
  @@index([spkStatus])
  @@map("plan_spk")
}
