# ==============================================================================
# CONTOH VARIABEL LINGKUNGAN (ENVIRONMENT VARIABLES)
# Sistem Pelaporan Plan SPK H-1 Agung Toyota UjungBatu (Cabang 220)
#
# Salin berkas ini ke .env untuk pengembangan lokal, atau masukkan nilainya
# ke dashboard Vercel Project Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Untuk Vercel Demo: Gunakan connection string Cloud Neon dengan pooling dan SSL
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-crimson-darkness-azl0rt9h-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Untuk Server Kantor Cabang 220 (Docker On-Premises FASE 2):
# DATABASE_URL="postgresql://postgres:postgres_secure_password@sales-db:5432/sales_report_db?schema=public"

# ------------------------------------------------------------------------------
# 2. Autentikasi NextAuth.js
# ------------------------------------------------------------------------------
# URL root aplikasi:
# - Lokal: http://localhost:3000
# - Vercel: https://your-project.vercel.app
NEXTAUTH_URL="https://your-project.vercel.app"

# Kunci rahasia untuk enkripsi token sesi (minimal 32 karakter acak)
# Buat string acak dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-kunci-enkripsi-rahasia-minimal-32-karakter"
AUTH_SECRET="ganti-dengan-kunci-enkripsi-rahasia-minimal-32-karakter"

# Diperlukan untuk deployment di balik reverse proxy / Vercel
AUTH_TRUST_HOST=true

# ------------------------------------------------------------------------------
# 3. WhatsApp Gateway Configuration (Baileys Daemon)
# ------------------------------------------------------------------------------
# Digunakan oleh daemon WhatsApp server kantor cabang (Fase On-Premises)
WHATSAPP_TARGET_GROUP_ID="120363431544093599@g.us"
WHATSAPP_API_URL="https://api.fonnte.com/send"
WHATSAPP_API_TOKEN="token_opsional_jika_pakai_gateway_eksternal"

# ------------------------------------------------------------------------------
# 4. Feature Flags (Dual-Track Deployment Guard)
# ------------------------------------------------------------------------------
# Vercel Early Access Demo: WAJIB bernilai false (mencegah spam ke grup kantor)
# Server Kantor On-Premises: Set true untuk mengaktifkan siaran otomatis ke grup
ENABLE_WA_NOTIFICATIONS=false

# URL publik aplikasi untuk aset dan PWA
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"
